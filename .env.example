# RapidAid 2.0 Environment Configuration Template
# Copy this file to .env to configure local settings
# Note: RapidAid runs safely in Demo Mode even without external API keys.

# Server Port (Default: 3000)
PORT=3000

# OpenAI API Key (For Audio Speech-to-Text transcription)
# Get your key from: https://platform.openai.com/api-keys
# Uses model: gpt-transcribe (or fallback whisper-1)
OPENAI_API_KEY=

# Google Gemini API Key (For Structured Emergency Summarization)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Demo Mode (Set to true to use realistic local mock AI responses without calling paid APIs)
# Ideal for college vivas, lab evaluations, and offline demonstrations
DEMO_MODE=true

# Escalation Timeout in Seconds (Default: 45 seconds; set to shorter e.g. 10 for quick viva demo)
ESCALATE_SECONDS=45

# Data Storage Directory (Default: data/)
DATA_DIR=data

